@import "tailwindcss";

@custom-variant dark (&:where(.dark, .dark *));


:root {
  --background: #f8fafc;
  --foreground: #0f172a;
}


.dark {
  --background: #020617;
  --foreground: #f8fafc;
}


body {
  background: var(--background);
  color: var(--foreground);
  transition: background 0.3s ease, color 0.3s ease;
}
