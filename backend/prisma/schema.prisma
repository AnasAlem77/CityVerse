generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id       String   @id @default(cuid())
  email    String   @unique
  name     String
  password String
  role     UserRole @default(USER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  savedPlaces SavedPlace[]
  reviews     Review[]
}

model City {
  id String @id @default(cuid())

  name    String
  country String

  description String?
  image       String?

  featured      Boolean @default(false)
  featuredOrder Int?

  latitude  Decimal @db.Decimal(9, 6)
  longitude Decimal @db.Decimal(9, 6)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  places Place[]
}

model Place {
  id String @id @default(cuid())

  // OSM identifier
  osmId String? @unique

  name        String
  description String
  category    String

  latitude  Decimal @db.Decimal(9, 6)
  longitude Decimal @db.Decimal(9, 6)

  cityId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  city City @relation(fields: [cityId], references: [id], onDelete: Cascade)

  images PlaceImage[]

  savedPlaces SavedPlace[]

  reviews Review[]
}

model PlaceImage {
  id String @id @default(cuid())

  url String

  placeId String

  createdAt DateTime @default(now())

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)
}

model SavedPlace {
  id String @id @default(cuid())

  userId  String
  placeId String

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([userId, placeId])
}

model Review {
  id String @id @default(cuid())

  rating Int

  comment String

  userId String

  placeId String

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([userId, placeId])
}