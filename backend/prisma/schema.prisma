generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum GoogleMatchStatus {
  PENDING
  SEARCHED
  MATCHED
  NO_MATCH
  LOW_CONFIDENCE
  FAILED
}

model User {
  id       String   @id @default(cuid())
  email    String   @unique
  name     String
  password String
  role     UserRole @default(USER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  savedPlaces SavedPlace[]
  reviews     Review[]
  ratings     PlaceRating[]
}

model City {
  id String @id @default(cuid())

  name    String
  country String

  description String?
  image       String?

  featured      Boolean @default(false)
  featuredOrder Int?

  latitude  Decimal @db.Decimal(9, 6)
  longitude Decimal @db.Decimal(9, 6)
  timezone String @default("UTC")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  places Place[]
  rawPlaces RawPlace[]
  curatedPlaces CuratedPlace[]
}

// Immutable-source staging records for future wide-area collection and dry runs.
// The existing Place table remains the production dataset.
model RawPlace {
  id String @id @default(cuid())

  osmId   String
  cityId  String
  name    String
  category String
  subtype String?
  rawTags Json

  description String
  address String?
  website String?
  phone String?
  openingHours String?
  cuisine String?
  wheelchair String?
  internetAccess String?

  latitude  Decimal @db.Decimal(9, 6)
  longitude Decimal @db.Decimal(9, 6)
  qualityScore Int @default(0)
  collectedAt DateTime @default(now())

  city City @relation(fields: [cityId], references: [id], onDelete: Cascade)
  curatedPlace CuratedPlace?

  @@unique([cityId, osmId])
  @@index([cityId, category, subtype])
  @@index([cityId, latitude, longitude])
}

model CuratedPlace {
  id String @id @default(cuid())

  rawPlaceId String @unique
  cityId String
  qualityScore Int
  importanceScore Int
  completenessScore Int
  geographicScore Int
  diversityScore Int
  totalScore Int
  tier String
  curationVersion String
  selectionReason String
  selectedAt DateTime @default(now())

  rawPlace RawPlace @relation(fields: [rawPlaceId], references: [id], onDelete: Cascade)
  city City @relation(fields: [cityId], references: [id], onDelete: Cascade)
  googleMatch GooglePlaceMatch?
  photos CuratedPlacePhoto[]

  @@index([cityId, qualityScore])
}

model GooglePlaceMatch {
  id String @id @default(cuid())

  curatedPlaceId String @unique
  googlePlaceId String?
  matchStatus GoogleMatchStatus @default(PENDING)
  confidenceScore Float?

  matchedName String?
  matchedAddress String?
  matchedLatitude Decimal? @db.Decimal(9, 6)
  matchedLongitude Decimal? @db.Decimal(9, 6)
  matchedPhone String?
  matchedWebsite String?
  rating Float?
  reviewCount Int?
  googleMapsUrl String?
  photoReferences Json?

  searchQuery String?
  candidateData Json?
  failureReason String?
  attempts Int @default(0)
  lastAttemptAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  curatedPlace CuratedPlace @relation(fields: [curatedPlaceId], references: [id], onDelete: Cascade)

  @@index([matchStatus, updatedAt])
  @@index([googlePlaceId])
}

model Place {
  id String @id @default(cuid())

  // OSM identifier
  osmId String? @unique

  name          String
  description   String?
  category      String
  subtype       String?

  address       String?
  website       String?
  phone         String?
  openingHours  String?
  cuisine       String?
  wheelchair    String?
  internetAccess String?

  latitude  Decimal @db.Decimal(9, 6)
  longitude Decimal @db.Decimal(9, 6)

  cityId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  city City @relation(fields: [cityId], references: [id], onDelete: Cascade)

  images PlaceImage[]
  cityVerseScore CityVerseScore?
  ratings PlaceRating[]

  savedPlaces SavedPlace[]

  reviews Review[]

  @@index([cityId, category, subtype])
}

model PlaceImage {
  id String @id @default(cuid())

  url String

  placeId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  source String @default("unknown")
  sourceUrl String?
  license String?
  author String?
  attribution String?
  width Int?
  height Int?

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)
}

model CityVerseScore {
  id String @id @default(cuid())
  placeId String @unique
  score Float
  qualityScore Float
  relevanceScore Float
  completenessScore Float
  importanceScore Float
  formulaVersion String
  calculatedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)
}

model PlaceRating {
  id String @id @default(cuid())
  userId String
  placeId String
  rating Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)
  @@unique([userId, placeId])
  @@index([placeId])
}

model CuratedPlacePhoto {
  id String @id @default(cuid())
  curatedPlaceId String
  imageUrl String
  source String
  sourceUrl String?
  license String?
  author String?
  attribution String?
  width Int?
  height Int?
  confidenceScore Float?
  matchStatus String @default("PENDING")
  failureReason String?
  attempts Int @default(0)
  lastAttemptAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  curatedPlace CuratedPlace @relation(fields: [curatedPlaceId], references: [id], onDelete: Cascade)
  @@unique([curatedPlaceId, imageUrl])
  @@index([curatedPlaceId, matchStatus])
}

model SavedPlace {
  id String @id @default(cuid())

  userId  String
  placeId String

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([userId, placeId])
}

model Review {
  id String @id @default(cuid())

  rating Int

  comment String

  userId String

  placeId String

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([userId, placeId])
}
